@using Metadata = SartainStudios.Client.Page.Metadata
<MudAppBar Elevation="1">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                   OnClick="DrawerToggle"/>
    <MudIconButton Icon="@Metadata.Invoicing.DashboardInfo.Icon" Href="@Metadata.Invoicing.DashboardInfo.Route"/>
    <MudText Typo="Typo.h6" Class="ml-2">@CurrentPageTitle</MudText>
    <MudSpacer/>
    <MudMenu AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight">
        <ActivatorContent>
            <UserAvatar PhotoUrl="@ProfilePhotoUrl" OnClick="@(e => context.ToggleAsync(e))"/>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Icon="@Metadata.Account.IndexInfo.Icon" Href="@Metadata.Account.IndexInfo.Route">
                @Metadata.Account.IndexInfo.Name
            </MudMenuItem>
            <MudDivider/>
            <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">Sign out</MudMenuItem>
        </ChildContent>
    </MudMenu>
</MudAppBar>