@using Metadata = SartainStudios.Client.Page.Metadata
@inherits LayoutComponentBase
<SectionShell HomeIcon="@Metadata.Invoicing.DashboardInfo.Icon"
              HomeRoute="@Metadata.Invoicing.DashboardInfo.Route"
              ShowBuildInfo="true">
    <NavLinks>
        <MudNavLink Href="@Metadata.Invoicing.DashboardRoute" Icon="@Metadata.Invoicing.DashboardInfo.Icon">
            @Metadata.Invoicing.DashboardInfo.Name
        </MudNavLink>
        <MudNavLink Href="@Metadata.Organization.Route" Icon="@Metadata.Organization.IndexInfo.Icon">
            @Metadata.Organization.IndexInfo.Name
        </MudNavLink>
        <MudNavLink Href="@Metadata.Client.Route" Icon="@Metadata.Client.Info.Icon">
            @Metadata.Client.Info.Name
        </MudNavLink>
        <MudNavLink Href="@Metadata.Project.Route" Icon="@Metadata.Project.Info.Icon">
            @Metadata.Project.Info.Name
        </MudNavLink>
        <MudNavLink Href="@Metadata.BillingContract.Route" Icon="@Metadata.BillingContract.Info.Icon">
            @Metadata.BillingContract.Info.Name
        </MudNavLink>
        <MudNavLink Href="@Metadata.Invoicing.SessionsRoute" Icon="@Metadata.Invoicing.Sessions.Icon">
            @Metadata.Invoicing.Sessions.Name
        </MudNavLink>
        <MudNavLink Href="@Metadata.Invoice.Route" Icon="@Metadata.Invoice.Info.Icon">
            @Metadata.Invoice.Info.Name
        </MudNavLink>
    </NavLinks>
    <AccountMenuItems>
        <MudMenuItem Icon="@Metadata.Account.IndexInfo.Icon" Href="@Metadata.Account.IndexInfo.Route">
            @Metadata.Account.IndexInfo.Name
        </MudMenuItem>
    </AccountMenuItems>
    <ChildContent>
        @Body
    </ChildContent>
</SectionShell>