@using SartainStudios.Client.Service

<MudDialog Visible="@Visible" VisibleChanged="OnVisibleChangedAsync" Options="DialogOptions"
           ContentClass="d-flex flex-column overflow-hidden">
    <TitleContent>
        <MudText Typo="Typo.h6">Import earnings using screenshots</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(Error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@Error</MudAlert>
        }
        @if (!string.IsNullOrEmpty(Notice))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@Notice</MudAlert>
        }
        @if (Busy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2"/>
            <MudText Class="mb-2">Working on this device. Long screenshots may take a few minutes.</MudText>
        }
    <div @key="(Reviewing ? 2 : Rows.Count > 0 ? 1 : 0)" class="overflow-x-hidden" style="flex:1 1 auto; min-height:0; overflow-y:auto;">
    <MudStack Spacing="3">
        @if (Rows.Count == 0)
        {
            <MudText Typo="Typo.body2">Images are read on this device. Choose screenshots from the same date and app; review every amount and assignment before saving.</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                <MudSelect T="string" Label="Screenshot app" @bind-Value="Platform" Disabled="@Busy" Style="min-width:170px">
                    <MudSelectItem T="string" Value="@EarningsScreenshotSource.Uber">Uber Eats</MudSelectItem>
                    <MudSelectItem T="string" Value="@EarningsScreenshotSource.DoorDash">DoorDash</MudSelectItem>
                </MudSelect>
                <MudDatePicker Label="Screenshot date" @bind-Date="Date" Disabled="@Busy" Style="min-width:170px"/>
            </MudStack>
            @if (SelectedSource is null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    The matching built-in earnings source is hidden or unavailable. Unhide it under Sources and categories before importing.
                </MudAlert>
            }
            <MudText Typo="Typo.body2">For DoorDash, select the date the dash started. Overnight dashes are supported.</MudText>
            <input @key="FileInputKey" @ref="FileInput" class="mud-width-full" type="file"
                   accept="image/*" multiple disabled="@Busy" aria-label="Choose screenshots"/>
        }
        @if (ReadResults.Count > 0)
        {
            <details>
                <summary>Show screenshots for comparison</summary>
                @foreach (var result in ReadResults)
                {
                    <MudText Typo="Typo.subtitle2" Class="mud-typography-nowrap" title="@result.Name">@result.Name</MudText>
                    <div style="max-height:30rem; overflow:auto">
                        <img src="@result.Url" alt="@result.Name" style="max-width:100%; height:auto"/>
                    </div>
                }
            </details>
            <details>
                <summary>Show recognized text</summary>
                @foreach (var result in ReadResults)
                {
                    <MudText Typo="Typo.subtitle2" Class="mud-typography-nowrap" title="@result.Name">@result.Name</MudText>
                    <pre style="white-space:pre-wrap; max-height:18rem; overflow:auto">@result.Text</pre>
                }
            </details>
        }
        @if (Rows.Count > 0 && !Reviewing)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Compare every row with the screenshots. Add missing rows and remove duplicates.
                Uber amounts include tips; DoorDash rows are whole dash totals, not individual offers.
                A dash crossing multiple sessions cannot be split from a shift total alone. Manual
                session choices can override the suggested times; verify them carefully.
            </MudAlert>
            @foreach (var row in Rows)
            {
                <MudPaper Class="pa-3" Outlined="true" @key="row">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2" Class="mud-typography-nowrap" title="@row.FileName">@row.FileName</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                            <MudNumericField T="decimal?" Label="Amount" @bind-Value="row.Amount" Min="0m" HideSpinButtons="true" Style="min-width:110px"/>
                            <MudTimePicker Label="@(Platform == EarningsScreenshotSource.Uber ? "Activity time" : "Dash start")" Time="row.Start" TimeChanged="value => ChangeStart(row, value)" AmPm="true" Style="min-width:150px"/>
                            @if (Platform == EarningsScreenshotSource.DoorDash)
                            {
                                <MudTimePicker Label="Dash end" Time="row.End" TimeChanged="value => ChangeEnd(row, value)" AmPm="true" Style="min-width:150px"/>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => Rows.Remove(row)" title="Remove row"/>
                        </MudStack>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => Suggest(row)">Suggest session from times</MudButton>
                        <MudSelect T="string" Label="Your session (leave unassigned to exclude)" @bind-Value="row.SessionId">
                            <MudSelectItem T="string" Value="@string.Empty">Unassigned</MudSelectItem>
                            @foreach (var session in ClosedSessions)
                            {
                                <MudSelectItem T="string" Value="@session.Id">@SessionLabel(session)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>
            }
        }
        @if (Reviewing)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @Rows.Count(x => string.IsNullOrEmpty(x.SessionId)) row(s) are unassigned and will not be saved.
                Choose an action for each session. Replace removes all existing earnings and notes for this source.
                The importer cannot detect previous imports.
            </MudAlert>
            @foreach (var proposal in Proposals)
            {
                <MudPaper Class="pa-3" Outlined="true" @key="proposal.Session.Id">
                    <MudText Typo="Typo.subtitle2">@SessionLabel(proposal.Session)</MudText>
                    <MudText>Screenshot total: @GigFormat.Money(proposal.Amount) (@proposal.Count row(s)).
                        Existing source earnings: @GigFormat.Money(proposal.Existing).</MudText>
                    @if (proposal.Saved)
                    {
                        <MudText Color="Color.Success">Saved</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" Label="Action" @bind-Value="proposal.Action" Disabled="@Busy">
                            <MudSelectItem T="string" Value="@("Skip")">Skip</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Add")">Add to existing earnings</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Replace")">Replace existing source earnings</MudSelectItem>
                        </MudSelect>
                    }
                </MudPaper>
            }
        }
    </MudStack>
    </div>
    </DialogContent>
    <DialogActions>
        <div class="d-flex flex-wrap justify-end gap-2 mud-width-full">
            <MudButton OnClick="CloseAsync" Disabled="@Busy">Close</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="Reset" Disabled="@Busy">Start over</MudButton>
            @if (Reviewing)
            {
                <MudButton Variant="Variant.Outlined" OnClick="BackToRows" Disabled="@Busy">Back to rows</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Busy">Save selected actions</MudButton>
            }
            else if (Rows.Count > 0)
            {
                <MudButton Variant="Variant.Outlined" OnClick="AddRow" Disabled="@Busy">Add missing row</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Prepare" Disabled="@Busy">Review session totals</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReadAsync" Disabled="@Busy">Read screenshots</MudButton>
            }
        </div>
    </DialogActions>
</MudDialog>