<button type="button"
        class="mud-button-root mud-icon-button"
        style="padding:4px;background:none;border:none;cursor:pointer;border-radius:50%;"
        aria-label="Account menu"
        @onclick="OnClick">
    <MudAvatar Size="Size.Medium">
        @if (!string.IsNullOrWhiteSpace(PhotoUrl) && !_imageFailed)
        {
            <img src="@PhotoUrl" alt="Profile photo" referrerpolicy="no-referrer"
                 style="width:100%;height:100%;object-fit:cover;"
                 @onerror="OnImageError"/>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle"/>
        }
    </MudAvatar>
</button>