@foreach (var item in Items)
{
    <MudItem xs="12" md="6">
        <MudButton Href="@item.Route"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="pa-6 rounded-lg"
                   Style="height: 100%; text-transform: none; text-align: left; align-items: stretch;">
            <MudStack Spacing="3" Style="width: 100%; height: 100%;">
                <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@item.Icon" Size="Size.Large"/>
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5" Style="font-weight: 600;">@item.Title</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@item.Tagline</MudText>
                    </MudStack>
                </MudStack>
                <MudStack Spacing="1">
                    @foreach (var highlight in item.Highlights)
                    {
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                     Color="Color.Primary"
                                     Size="Size.Small"/>
                            <MudText Typo="Typo.body2" Style="white-space: normal;">@highlight</MudText>
                        </MudStack>
                    }
                </MudStack>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-auto pt-2">
                    <MudText Typo="Typo.button" Color="Color.Primary">@item.ActionText</MudText>
                    <MudIcon Icon="@ActionIcon" Size="Size.Small"
                             Color="Color.Primary"/>
                </MudStack>
            </MudStack>
        </MudButton>
    </MudItem>
}