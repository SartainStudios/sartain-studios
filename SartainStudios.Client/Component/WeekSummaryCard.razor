@{
    RenderFragment<(string Label, string Value)> row = item =>
        @<MudStack Row="true" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Label</MudText>
            <MudText Typo="Typo.body2">@item.Value</MudText>
        </MudStack>;
}
@if (IsLoading || Week is null)
{
    <LoadingSkeleton Variant="LoadingSkeletonVariant.Text" Rows="4"/>
}
else
{
    <MudStack Spacing="1">
        <MudText Typo="Typo.subtitle1">@Title</MudText>
        <MudText Typo="Typo.h4">@GigFormat.Money(Week.Profit)</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Profit (earnings minus expenses)</MudText>
        <MudDivider Class="my-1"/>
        @row(("Earnings", GigFormat.Money(Week.Gross)))
        @row(("Expenses", GigFormat.Money(Week.Expenses)))
        @row(("Hours", GigFormat.Hours(Week.Minutes)))
        @row(("Hourly rate", GigFormat.Rate(Week.GrossHourlyRate)))
        @row(("Profit per hour", GigFormat.Rate(Week.ProfitHourlyRate)))
        @row(("Miles", Week.Miles.ToString("0.#")))
        @if (ShowDeduction && Week.MileageDeduction is { } deduction)
        {
            <MudDivider Class="my-1"/>
            @row(("Estimated mileage deduction", GigFormat.Money(deduction)))
            @row(("Profit after deduction", GigFormat.Money(Week.ProfitAfterDeduction ?? Week.Profit)))
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @Week.SessionCount session@(Week.SessionCount == 1 ? string.Empty : "s")
        </MudText>
    </MudStack>
}