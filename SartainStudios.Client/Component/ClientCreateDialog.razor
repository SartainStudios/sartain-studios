@using SartainStudios.Client.Service.Validation
@namespace SartainStudios.Client.Component
<MudDialog Visible="@Visible" VisibleChanged="OnVisibleChangedAsync" Options="DialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Business"/>
            <MudText Typo="Typo.h6">New client</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="CreateForm">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="NewCompanyName" Label="Company name" Required="true" Disabled="IsBusy"/>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="NewContactPerson" Label="Contact person" Required="true"
                                  Disabled="IsBusy"/>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="NewEmail" Label="Email" InputType="InputType.Email" Required="true"
                                  Validation="@(new Func<string, string?>(FieldValidators.ValidateRequiredEmail))"
                                  Disabled="IsBusy"/>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="NewPhoneNumber" Label="Phone number" InputType="InputType.Telephone"
                                  Required="true"
                                  Validation="@(new Func<string, string?>(FieldValidators.ValidateRequiredPhoneNumber))"
                                  Disabled="IsBusy"/>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-n2">Address</MudText>
                </MudItem>
                <MudItem xs="12">
                    <AddressFields Value="NewAddress" Required="true" Disabled="IsBusy"/>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAsync" Disabled="IsBusy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Disabled="IsBusy">
            @(IsBusy ? "Creating..." : "Save client")
        </MudButton>
    </DialogActions>
</MudDialog>