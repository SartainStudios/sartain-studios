@namespace SartainStudios.Client.Component
<MudDialog Visible="@Visible" VisibleChanged="OnVisibleChangedAsync" Options="DialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icon" Color="@ConfirmColor"/>
            <MudText Typo="Typo.h6">@Title</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">@Message</MudText>
        @if (!string.IsNullOrWhiteSpace(Details))
        {
            <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">@Details</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelAsync" Disabled="IsBusy">@CancelText</MudButton>
        <MudButton Variant="Variant.Filled" Color="@ConfirmColor" StartIcon="@ConfirmIcon" OnClick="ConfirmAsync"
                   Disabled="IsBusy">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>