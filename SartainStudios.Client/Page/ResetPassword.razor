@using SartainStudios.Client.Layout
@using SartainStudios.Schema.Authentication
@attribute [Route(Metadata.Account.ResetPasswordRoute)]
@layout Empty
<PageHeader Title="Reset password"/>
<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex justify-center align-center"
              Style="min-height: 100vh; padding-top: 40px; padding-bottom: 40px;">
    <MudPaper Class="pa-8" Elevation="1" Style="width: 100%; border-radius: 12px;">
        <MudStack Spacing="6" Class="mb-2">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h4" Class="font-weight-bold">Reset password</MudText>
                <MudText Typo="Typo.body2">Enter a new password for your account.</MudText>
            </MudStack>
            @if (string.IsNullOrWhiteSpace(Token))
            {
                <MudAlert Severity="Severity.Error">
                    This password reset link is missing or invalid. Please request a new one.
                </MudAlert>
            }
            else if (IsSubmitted)
            {
                <MudAlert Severity="Severity.Success">
                    Your password has been reset. You can now sign in with your new password.
                </MudAlert>
            }
            else
            {
                <MudStack Spacing="3">
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                            @ErrorMessage
                        </MudAlert>
                    }
                    <MudTextField T="string"
                                  Label="New password"
                                  @bind-Value="NewPassword"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  FullWidth="true"
                                  HelperText="@($"Minimum {MinimumPasswordLength} characters")"
                                  Error="@(FieldError(AuthenticationErrors.NewPasswordField) is not null)"
                                  ErrorText="@FieldError(AuthenticationErrors.NewPasswordField)"/>
                    <MudTextField T="string"
                                  Label="Confirm new password"
                                  @bind-Value="ConfirmPassword"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  FullWidth="true"
                                  Error="@(FieldError(ConfirmPasswordField) is not null)"
                                  ErrorText="@FieldError(ConfirmPasswordField)"/>
                </MudStack>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SubmitAsync"
                           Disabled="IsBusy"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="mt-2">
                    @if (IsBusy)
                    {
                        <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true"/>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Reset password</span>
                    }
                </MudButton>
            }
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       FullWidth="true"
                       Href="@Metadata.Account.SignInRoute">
                Sign in
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>