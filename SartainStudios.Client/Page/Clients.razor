@using Microsoft.AspNetCore.Authorization
@using SartainStudios.Client.Layout
@using SartainStudios.Client.Service.Validation
@using SartainStudios.Schema.Invoice
@attribute [Route(Metadata.Client.Route)]
@attribute [Authorize]
@layout Main
<PageHeader Title='@(SelectedClient is null ? "Clients" : SelectedClient.CompanyName)'/>
<MudContainer MaxWidth="@(IsDetailView ? MaxWidth.Large : MaxWidth.ExtraLarge)" Class="my-4 my-sm-6">
    <MudStack Spacing="4">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@ErrorMessage</MudAlert>
        }
        @if (IsDetailView)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="@Metadata.Client.Route">
                    Clients
                </MudButton>
                <MudSpacer/>
                @if (CanManage && SelectedClient is not null)
                {
                    @if (!IsEditMode)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   Href="@Metadata.Client.Edit(Id!)">
                            Edit
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Href="@Metadata.Client.Detail(Id!)" Disabled="IsBusy">
                            Cancel
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="IsBusy">
                            @(IsBusy ? "Saving..." : "Save")
                        </MudButton>
                    }
                }
            </MudStack>
            @if (IsLoading)
            {
                <LoadingSkeleton Variant="LoadingSkeletonVariant.Detail" Rows="4"/>
            }
            else if (SelectedClient is null)
            {
                <MudAlert Severity="Severity.Warning">Client not found.</MudAlert>
            }
            else
            {
                <MudPaper Class="pa-4 pa-sm-6" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudAvatar Color="Color.Primary" Size="Size.Large">
                            <MudIcon Icon="@Icons.Material.Filled.Business"/>
                        </MudAvatar>
                        <MudStack Spacing="0" Style="min-width:0;">
                            <MudText Typo="Typo.h5" Class="text-truncate">@SelectedClient.CompanyName</MudText>
                            <MudText Color="Color.Secondary">Attn: @SelectedClient.ContactPerson</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
                <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true">
                    <MudTabPanel Text="Details" Icon="@Icons.Material.Filled.Info">
                        <MudStack Spacing="4" Class="pa-4 pa-sm-6">
                            @if (IsEditMode)
                            {
                                <MudForm @ref="EditForm">
                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="CompanyName" Label="Company name" Required="true"
                                                          Disabled="IsBusy"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="ContactPerson" Label="Contact person"
                                                          Required="true" Disabled="IsBusy"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="Email" Label="Email" InputType="InputType.Email"
                                                          Required="true"
                                                          Validation="@(new Func<string, string?>(FieldValidators.ValidateRequiredEmail))"
                                                          Disabled="IsBusy"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="PhoneNumber" Label="Phone number"
                                                          InputType="InputType.Telephone"
                                                          Required="true"
                                                          Validation="@(new Func<string, string?>(FieldValidators.ValidateRequiredPhoneNumber))"
                                                          Disabled="IsBusy"/>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.subtitle2" Class="mb-n2">Address</MudText>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <AddressFields Value="Address" Required="true" Disabled="IsBusy"/>
                                        </MudItem>
                                    </MudGrid>
                                </MudForm>
                            }
                            else
                            {
                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">COMPANY</MudText>
                                            <MudText Typo="Typo.h6">@SelectedClient.CompanyName</MudText>
                                            <MudText Typo="Typo.body2">Attn: @SelectedClient.ContactPerson</MudText>
                                        </MudStack>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">CONTACT</MudText>
                                            @foreach (var line in SelectedClient.Address.ToLines())
                                            {
                                                <MudText Typo="Typo.body2">@line</MudText>
                                            }
                                            <MudText Typo="Typo.body2">@SelectedClient.Email</MudText>
                                            <MudText Typo="Typo.body2">@SelectedClient.PhoneNumber</MudText>
                                        </MudStack>
                                    </MudItem>
                                </MudGrid>
                            }
                        </MudStack>
                    </MudTabPanel>
                    <MudTabPanel Text="Billing History" Icon="@Icons.Material.Filled.Receipt">
                        <MudStack Spacing="4" Class="pa-4 pa-sm-6">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle1">Invoices</MudText>
                                <MudSpacer/>
                                <MudText Color="Color.Secondary">
                                    @Invoices.Count invoice@(Invoices.Count == 1 ? string.Empty : "s")
                                </MudText>
                            </MudStack>
                            @if (IsLoadingInvoices)
                            {
                                <LoadingSkeleton Variant="LoadingSkeletonVariant.Table" Rows="3" Columns="5"/>
                            }
                            else if (Invoices.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    No invoices have been generated for this client yet.
                                </MudAlert>
                            }
                            else
                            {
                                <MudTable T="Summary" Items="Invoices" Dense="true"
                                          Hover="true">
                                    <HeaderContent>
                                        <MudTh>Invoice #</MudTh>
                                        <MudTh>Project</MudTh>
                                        <MudTh>Due date</MudTh>
                                        <MudTh>Total</MudTh>
                                        <MudTh>Status</MudTh>
                                        <MudTh Style="text-align:right;">Actions</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Invoice #">@context.InvoiceNumber</MudTd>
                                        <MudTd DataLabel="Project">@context.ProjectName</MudTd>
                                        <MudTd DataLabel="Due date">@context.DueDate.ToLocalTime().ToString("d")</MudTd>
                                        <MudTd DataLabel="Total">@context.TotalAmount.ToString("C")</MudTd>
                                        <MudTd DataLabel="Status">
                                            <MudChip T="string" Color="@GetStatusColor(context.Status)"
                                                     Size="Size.Small">@context.Status</MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Actions" Style="text-align:right;">
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                           Href="@Metadata.Invoice.Detail(context.Id)"
                                                           title="View invoice"/>
                                        </MudTd>
                                    </RowTemplate>
                                    <FooterContent>
                                        <MudTd colspan="6">
                                            <MudStack Row="true" Justify="Justify.FlexEnd" Class="pa-2">
                                                <MudText Typo="Typo.subtitle2">
                                                    Total billed: <strong>@TotalBilled.ToString("C")</strong>
                                                </MudText>
                                            </MudStack>
                                        </MudTd>
                                    </FooterContent>
                                </MudTable>
                            }
                        </MudStack>
                    </MudTabPanel>
                </MudTabs>
            }
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">Clients</MudText>
                    <MudText Color="Color.Secondary">Manage your clients and view their billing history.</MudText>
                </MudStack>
            </MudStack>
            @if (ClientSummaries is null)
            {
                <LoadingSkeleton Variant="LoadingSkeletonVariant.Table" Rows="5" Columns="5"/>
            }
            else if (ClientSummaries.Count == 0)
            {
                <MudPaper Class="pa-6" Elevation="1">
                    <MudStack Spacing="3" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Secondary"
                                 Style="font-size:3rem;"/>
                        <MudText Typo="Typo.h6">No clients yet</MudText>
                        <MudText Color="Color.Secondary">Add your first client to start tracking billable work.
                        </MudText>
                        @if (CanManage)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">
                                Add your first client
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
            else
            {
                <MudTable T="SartainStudios.Schema.Client.Summary" Items="ClientSummaries" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Company</MudTh>
                        <MudTh>Contact</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Phone</MudTh>
                        <MudTh Style="text-align:right;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Company">@context.CompanyName</MudTd>
                        <MudTd DataLabel="Contact">@context.ContactPerson</MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Phone">@context.PhoneNumber</MudTd>
                        <MudTd DataLabel="Actions" Style="text-align:right;">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                           Href="@Metadata.Client.Detail(context.Id)" title="View client"/>
                            @if (CanManage)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               Href="@Metadata.Client.Edit(context.Id)" title="Edit client"/>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="() => DeleteAsync(context)" Disabled="IsBusy"
                                               title="Delete client"/>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudStack>
</MudContainer>
<ClientCreateDialog Visible="@ShowCreate"
                    VisibleChanged="OnCreateDialogVisibleChangedAsync"
                    IsBusy="IsBusy"
                    OnCreate="CreateAsync"/>
@if (!IsDetailView && CanManage)
{
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate"
            title="New client"
            Style="position:fixed; bottom:24px; right:24px; z-index:1000;"/>
}