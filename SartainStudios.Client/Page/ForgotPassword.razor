@using SartainStudios.Client.Layout
@using SartainStudios.Schema.Authentication
@attribute [Route(Metadata.Account.ForgotPasswordRoute)]
@layout Empty
<PageHeader Title="Forgot password"/>
<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex justify-center align-center"
              Style="min-height: 100vh; padding-top: 40px; padding-bottom: 40px;">
    <MudPaper Class="pa-8" Elevation="1" Style="width: 100%; border-radius: 12px;">
        <MudStack Spacing="6" Class="mb-2">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h4" Class="font-weight-bold">Forgot password</MudText>
                <MudText Typo="Typo.body2">
                    Enter your email address and we'll send you a link to reset your password.
                </MudText>
            </MudStack>
            @if (IsSubmitted)
            {
                <MudAlert Severity="Severity.Success">
                    If an account exists for that email, we've sent a password reset link. Please check your inbox.
                </MudAlert>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                        @ErrorMessage
                    </MudAlert>
                }

                <MudTextField T="string"
                              Label="Email address"
                              @bind-Value="Email"
                              InputType="InputType.Email"
                              Placeholder="you@example.com"
                              Variant="Variant.Outlined"
                              Required="true"
                              FullWidth="true"
                              Clearable="true"
                              Error="@(FieldError(AuthenticationErrors.EmailField) is not null)"
                              ErrorText="@FieldError(AuthenticationErrors.EmailField)"/>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SubmitAsync"
                           Disabled="IsBusy"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="mt-2">
                    @if (IsBusy)
                    {
                        <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true"/>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send reset link</span>
                    }
                </MudButton>
            }
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       FullWidth="true"
                       Href="@Metadata.Account.SignInRoute">
                Sign In
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>